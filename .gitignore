# Build artifacts (regenerable, huge)
/target

# Raw run outputs: full transcripts, per-trial sandboxes, cost/latency numbers,
# and machine-specific data. Never commit — it bloats history and can leak
# details about whoever ran the eval (prompts under test, model, spend, paths).
# The versioned record of "how the suite scored" is the distilled report in
# baselines/, not this tree.
/results

# Local snapshots and secrets
*.zip
.env
.env.*

# OS / editor junk
.DS_Store
*.swp
*~

# stray tool caches
.mypy_cache/
__pycache__/
*.pyc

# Local agent scaffolding (opsx commands and skills): machine-local, regenerable
.claude/

# Review artifacts the review/ship tooling drops next to a change: rendered
# reports, the raw diff they were built from, translation glosses. The
# versioned record of a change is its own markdown, not these.
openspec/changes/**/diff-review.*
openspec/changes/**/review.html
openspec/changes/**/review-quiz.json
openspec/changes/**/diff.patch
openspec/changes/**/gloss.*.json
